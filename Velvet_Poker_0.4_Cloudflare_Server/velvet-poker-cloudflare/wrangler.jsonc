{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "velvet-poker",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "CLUB", "class_name": "VelvetClub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VelvetClub"] }],
  "observability": { "enabled": false }
}
